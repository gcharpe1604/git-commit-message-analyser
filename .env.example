# GitHub API Configuration
# Get your token from: https://github.com/settings/tokens
# Scopes needed: public_repo (for public repositories)
# VITE_GITHUB_TOKEN=your_token_here

# API Configuration (optional - defaults are provided)
# VITE_GITHUB_API_URL=https://api.github.com

# Supabase (required for sign-in and synced analysis history)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Netlify Functions only. Never prefix secret provider keys with VITE_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-or-service-role-key
GROQ_API_KEY=your-groq-key
OPENROUTER_API_KEY=your-openrouter-key
GEMINI_API_KEY=your-gemini-key

# Local-only signed-in feature testing. These work only with `netlify dev` and
# are ignored by deployed Netlify Functions.
VITE_DEV_AUTH_BYPASS=true
VITE_DEV_AUTH_BYPASS_TOKEN=choose-a-long-local-only-token
AI_DEV_BYPASS_TOKEN=choose-the-same-long-local-only-token
